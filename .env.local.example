# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your_anon_key_here>
# Service role key: Supabase → Settings → API → service_role (secret, server-only)
SUPABASE_SERVICE_ROLE_KEY=<your_service_role_key_here>

# ── Telegram Admin Bot ────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=<your_bot_token_here>
# Your chat_id from @userinfobot
TELEGRAM_ADMIN_CHAT_ID=<your_chat_id_here>
# Webhook secret (openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=<your_webhook_secret_here>

# ── Vercel Cron (generates daily subscription checks) ─────────
# Generate: openssl rand -hex 32
CRON_SECRET=<your_cron_secret_here>

# ── AI (chat widget / bio generator) ─────────────────────────
# Get from console.groq.com → API Keys
GROQ_API_KEY=<your_groq_api_key_here>

# ── vCard HMAC signing key (separate from service role key) ───
# Generate: openssl rand -hex 32
VCARD_SECRET=<your_vcard_secret_here>

# ── Analytics (optional — both are independent) ───────────────
# Yandex Metrica: metrika.yandex.ru → Счётчики → ID счётчика (number only)
# NEXT_PUBLIC_YM_ID=12345678
# Google Analytics 4: analytics.google.com → Admin → Data Streams → Measurement ID
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Payment receipt auto-approval (required for AI auto-approve) ─
# Your Kaspi merchant name as it appears on receipts (e.g. "ТОО TAPNI" or phone number)
# Without this, ALL receipts go to manual admin review (safer, recommended)
# KASPI_MERCHANT_ID=<your_merchant_name_or_phone>

# ── Halyk EPAY online payments (server-only) ─────────────────
# Credentials from epay.homebank.kz merchant cabinet
EPAY_CLIENT_ID=<your_epay_client_id>
EPAY_CLIENT_SECRET=<your_epay_client_secret>
EPAY_TERMINAL=<your_epay_terminal_id>
# Set test only while testing with EPAY test credentials
EPAY_MODE=production
# Public canonical URL used for EPAY callbacks (defaults to https://tapni.kz)
NEXT_PUBLIC_SITE_URL=https://tapni.kz
# Optional client-side test switch; keep in sync with EPAY_MODE
# NEXT_PUBLIC_EPAY_MODE=test

# ── After deploy: register Telegram webhook ───────────────────
# curl "https://api.telegram.org/bot{TOKEN}/setWebhook?url=https://tapni.kz/api/telegram-bot&secret_token={TELEGRAM_WEBHOOK_SECRET}"
